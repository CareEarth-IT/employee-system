# GCP プロジェクト: ce-gr-employee-info-2606st
# 本番 URL: https://employee.careearth.net

GCP_PROJECT_ID=ce-gr-employee-info-2606st
GCP_REGION=asia-northeast1
GCP_SERVICE=employee
GCP_AR_REPO=employee
GCP_DOMAIN=employee.careearth.net
APP_URL=https://employee.careearth.net

# 部署別社内サイト（employee 経由プロキシ → 非公開 Cloud Run）
REAL_ESTATE_PORTAL_INTERNAL_URL=https://real-estate-portal-3hlnt2gvnq-an.a.run.app
REAL_ESTATE_PORTAL_USE_IDENTITY_TOKEN=false
# DISPATCH_PORTAL_INTERNAL_URL=
# SPECIFIED_SKILLS_PORTAL_INTERNAL_URL=
# FOOD_PORTAL_INTERNAL_URL=
# TELECOM_PORTAL_INTERNAL_URL=
# BEAUTY_PORTAL_INTERNAL_URL=

# Cloud SQL (instance name: employee)
GCP_CLOUD_SQL=ce-gr-employee-info-2606st:asia-northeast1:employee
DB_DATABASE=ceemployee
DB_USERNAME=ceemployee

# Cloud Storage（プロフィール写真）
# バケット作成: deploy\setup-gcs-bucket.cmd
GCS_BUCKET=ce-gr-employee-info-2606st-employee-photos
FILESYSTEM_PROFILE_PHOTOS_DISK=gcs
FILESYSTEM_DASHBOARD_CONTENTS_DISK=gcs
FILESYSTEM_BRANDING_DISK=gcs

