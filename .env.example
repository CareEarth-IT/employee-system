APP_NAME="CE-Group 社員専用"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://employee.local
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# ローカル（XAMPP MySQL）例:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=employee
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
# 本番・MySQL利用時: SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# プロフィール写真: ローカルは public、本番は gcs（deploy で自動設定）
FILESYSTEM_PROFILE_PHOTOS_DISK=public
FILESYSTEM_DASHBOARD_CONTENTS_DISK=public
FILESYSTEM_BRANDING_DISK=public
# GOOGLE_CLOUD_PROJECT_ID=ce-gr-employee-info-2606st
# GCS_BUCKET=ce-gr-employee-info-2606st-employee-photos
# GOOGLE_CLOUD_KEY_FILE=（ローカルで GCS を試す場合のサービスアカウント JSON パス）
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# --- ローカルでメール受信を確認（Mailpit）---
# 1. deploy\mailpit.cmd で起動
# 2. 下記に切り替えて php artisan config:clear
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# 3. ブラウザで http://localhost:8025 を開く
# 4. php artisan mail:test または備品購入申請で確認

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- 本番メール (Google Workspace SMTP) ---
# ローカルは MAIL_MAILER=log のままで可。
# 本番へ Gmail を反映: deploy\deploy-gmail-mail-prod.cmd
# さくら SMTP へ切替: deploy\deploy-sakura-mail-prod.cmd
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yuta_masui@careearth.info
MAIL_PASSWORD=（Google アプリパスワード）
MAIL_FROM_ADDRESS=yuta_masui@careearth.info
MAIL_FROM_NAME="CE-Group 社員専用"

# 備品購入: 社内・3万円以上の承認依頼メール先（カンマ区切りで複数可）
# EQUIPMENT_PURCHASE_INTERNAL_OVER_30K_APPROVER_EMAILS=takuya_nishi@careearth.info

# 備品購入: 情報システム部申請の承認依頼メール先（カンマ区切りで複数可）
# EQUIPMENT_PURCHASE_INFORMATION_SYSTEMS_APPROVER_EMAILS=mariko_nakamoto@careearth.info

# 備品購入: 上長以上申請を全部署で承認できるアカウント（カンマ区切りで複数可）
# EQUIPMENT_PURCHASE_GLOBAL_MANAGER_APPROVER_EMAILS=employee@gmail.com
# 上記アカウントの確認者欄の初期表示名
# EQUIPMENT_PURCHASE_GLOBAL_MANAGER_APPROVER_DISPLAY_NAME=上長

# 備品購入（食品）: 桃谷店・3万円以上 → ティエンさん
# EQUIPMENT_PURCHASE_FOOD_MOMOTANI_OVER_30K_APPROVER_EMAILS=nguyenphuong_tien@careearth.info
# 備品購入（食品）: 緊急対応（事後申請）・3万円未満 → 杉浦さん
# EQUIPMENT_PURCHASE_FOOD_EMERGENCY_UNDER_30K_APPROVER_EMAILS=kanji_sugiura@careearth.info
# 備品購入（食品）: 緊急対応（事後申請）・3万円以上 → ティンさん
# EQUIPMENT_PURCHASE_FOOD_EMERGENCY_OVER_30K_APPROVER_EMAILS=buicuongthinh@careearth.info
# 備品購入（食品）: 物流センター・3万円以上 → 杉浦さん
# EQUIPMENT_PURCHASE_FOOD_LOGISTICS_OVER_30K_APPROVER_EMAILS=kanji_sugiura@careearth.info

# Top Page: 全部署のお知らせ・リンクを閲覧・編集できるメール（カンマ区切り）
# 未設定時のデフォルト: ginga_fukui@careearth.info
# DASHBOARD_MANAGER_EMAILS=ginga_fukui@careearth.info

# WordPress（本番 /wordpress。Cloud SQL に wp_* テーブル）
# WORDPRESS_SITE_URL=https://employee.careearth.net/wordpress
# WORDPRESS_SITE_TITLE=CE-Group お知らせ
# WORDPRESS_ADMIN_USER=ceadmin
# WORDPRESS_ADMIN_PASSWORD=
# WORDPRESS_ADMIN_EMAIL=yuta_masui@careearth.info
# WP-Stateless / GCS（組織ポリシーで SA JSON キー作成不可のため ADC を使用）
# WORDPRESS_GCS_BUCKET=ce-gr-employee-info-2606st-wp-images
# WORDPRESS_GCS_MODE=stateless
# WORDPRESS_GCS_USE_ADC=1

# 経理・人事お問い合わせ（apps/finance-hr）
# FINANCE_HR_WEB_APP_URL=http://employee.local/finance-hr
# FINANCE_HR_DB_HOST=127.0.0.1
# FINANCE_HR_DB_DATABASE=finance_hr
# FINANCE_HR_DB_USERNAME=root
# FINANCE_HR_DB_PASSWORD=
# FINANCE_HR_SSO_SECRET=
# FINANCE_HR_CHAT_WEBHOOK_URL=
# FINANCE_HR_CHAT_WEBHOOK_URL_HR=
# 問い合わせ分類・権限マトリクスの編集者（カンマ区切り）。未設定時は FINANCE_HR_ADMIN_EMAILS と同じ
# FINANCE_HR_PERMISSION_CONFIG_ADMIN_EMAILS=
# コア読み込み前のカスタム PHP: docker/wordpress/wp-config-extra.php

# 部署別社内サイト（employee 経由プロキシ → 非公開 Cloud Run。社員共通タブにはリンクなし）
REAL_ESTATE_PORTAL_INTERNAL_URL=https://real-estate-portal-3hlnt2gvnq-an.a.run.app
# employee プロジェクト内 real-estate-portal へプロキシ（real-estate プロジェクト IAM 不要）
# deploy\deploy-realestate-portal.cmd でデプロイ後、同一プロジェクト invoker + 共有秘密鍵を設定
REAL_ESTATE_PORTAL_USE_IDENTITY_TOKEN=true
# EMPLOYEE_PORTAL_PROXY_SECRET=
# 不動産ポータル等が参照する社員一覧 API（GET /internal/portal/employee-directory）
# Header: X-Employee-Portal-Proxy-Secret
# DISPATCH_PORTAL_INTERNAL_URL=
# DISPATCH_PORTAL_USE_IDENTITY_TOKEN=true
# SPECIFIED_SKILLS_PORTAL_INTERNAL_URL=https://specified-skills-portal-3hlnt2gvnq-an.a.run.app
# deploy\deploy-specified-skills-portal.cmd でデプロイ後に設定
# SPECIFIED_SKILLS_PORTAL_USE_IDENTITY_TOKEN=true
# FOOD_PORTAL_INTERNAL_URL=
# FOOD_PORTAL_USE_IDENTITY_TOKEN=true
# TELECOM_PORTAL_INTERNAL_URL=
# TELECOM_PORTAL_USE_IDENTITY_TOKEN=true
# BEAUTY_PORTAL_INTERNAL_URL=
# BEAUTY_PORTAL_USE_IDENTITY_TOKEN=true

# --- 社用車管理 (gas-app / ce-gr-drive-2605st) ---
# gas-app 側と同じ EMPLOYEE_SITE_SYNC_SECRET を設定（setup-employee-site-sync-cloudrun.ps1 参照）
# employee から POST: /api/integrations/employee-site/staff-profiles
# Header: X-Employee-Site-Secret
# Body: { "email", "name", "employmentType": "employee"|"part_time", "departmentName" }
DRIVE_APP_API_URL=https://gas-app-231655548437.asia-northeast1.run.app
# EMPLOYEE_SITE_SYNC_SECRET=

# --- 開発依頼（旧 GAS 開発依頼フォーム） ---
# Google Chat Incoming Webhook（未設定なら通知なし）
# DEVELOPMENT_REQUEST_CHAT_WEBHOOK_URL=
# 編集権限＝所属キーワード（デフォルト: 情報システム）
# DEVELOPMENT_REQUEST_EDITOR_DEPARTMENT_KEYWORDS=情報システム
# 閲覧のみ＝所属キーワード（デフォルト: 役員）。編集者は自動で閲覧可
# DEVELOPMENT_REQUEST_VIEWER_DEPARTMENT_KEYWORDS=役員

